# Normalise every text file to LF in the repository.
# Working trees on Windows still check out CRLF via core.autocrlf.
* text=auto eol=lf

# Binaries: never touch, never diff as text.
*.pdf   binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
