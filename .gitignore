# This repository is PUBLIC and every tracked file is served by GitHub Pages.
# Nothing career-related belongs here: the CV and Skills Overview PDFs are
# published from the curriculum-vitae repo and linked, not copied.

# Never publish source evidence or working documents.
*.private.md
*.private.*
.career-source/
payslip*
Payslip*
PAYSLIP*
*ayslip*
*eference*etter*
*VSP*

# Career artefacts live in the curriculum-vitae repo, not here.
*.pdf
*.docx
*.doc

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated context render - re-derives from workspace contents.
live-context.md

# Per-session git worktrees live inside the repo because the parent
# directory is outside the folder shared with agent sessions.
.worktrees/

# --- Content-guard private pattern set -------------------------------------
# This repo is public and Pages serves every tracked file, so the guard must
# not carry the values it checks for. Injected in CI from a repository secret.
.content-guard-patterns.json

__pycache__/
*.pyc
